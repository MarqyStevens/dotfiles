# --- Tailscale Mesh (works everywhere: home + work) ---
Host ms-asus
    HostName 100.89.119.100
    User ms

Host ms-slimbook
    HostName 100.95.136.60
    User ms

Host ms-thinkcentre
    HostName 100.76.26.44
    User ms

Host debian
    HostName 100.74.85.84

# --- Home LAN Fallbacks (same router, Tailscale OFF) ---
Host ms-asus-lan
    HostName 192.168.0.114
    User ms

Host ms-slimbook-lan
    HostName 192.168.0.110
    User ms

Host ms-thinkcentre-lan
    HostName 192.168.0.176
    User ms

