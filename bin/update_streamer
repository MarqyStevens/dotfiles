#!/usr/bin/env python3
import urllib.request
import json
import subprocess
import os
import sys
import re

DEVICE = "192.168.0.215:5555"

# Definícia spravovaných sideload aplikácií
APPS = [
    {
        "name": "Bitwarden",
        "package": "com.x8bit.bitwarden",
        "type": "github",
        "repo": "bitwarden/android",
        "match": lambda f: f.endswith(".apk") and ("armeabi-v7a" in f or "v7a" in f or "universal" in f or f == "com.x8bit.bitwarden.apk")
    },
    {
        "name": "App Manager",
        "package": "io.github.muntashirakon.AppManager",
        "type": "github",
        "repo": "MuntashirAkon/AppManager",
        "match": lambda f: f.endswith(".apk") and "debug" not in f
    },
    {
        "name": "Brave Browser",
        "package": "com.brave.browser",
        "type": "github",
        "repo": "brave/brave-browser",
        "match": lambda f: f == "BraveMonoarm.apk"
    },
    {
        "name": "KDE Connect",
        "package": "org.kde.kdeconnect_tp",
        "type": "fdroid",
        "repo_url": "https://f-droid.org/api/v1/packages/org.kde.kdeconnect_tp"
    }
]

HEADERS = {"User-Agent": "Mozilla/5.0"}

def run_adb(args):
    cmd = ["adb", "-s", DEVICE] + args
    return subprocess.run(cmd, capture_output=True, text=True)

def ensure_connected():
    print(f"🔌 Overujem spojenie so Streamerom ({DEVICE})...")
    res = subprocess.run(["adb", "devices"], capture_output=True, text=True)
    if DEVICE not in res.stdout or "device" not in [line.split()[-1] for line in res.stdout.strip().split("\n") if DEVICE in line]:
        print(f"🔄 Pripájam k {DEVICE}...")
        conn = subprocess.run(["adb", "connect", DEVICE], capture_output=True, text=True)
        if "connected" not in conn.stdout.lower():
            print(f"❌ Nepodarilo sa pripojiť k {DEVICE}: {conn.stdout.strip()}")
            sys.exit(1)
    print("✅ Spojenie aktívne.\n")

def get_installed_version(package):
    res = run_adb(["shell", "dumpsys", "package", package])
    if res.returncode != 0:
        return None
    match = re.search(r"versionName=([^\s]+)", res.stdout)
    return match.group(1) if match else None

def get_github_latest(repo, match_func):
    url = f"https://api.github.com/repos/{repo}/releases/latest"
    req = urllib.request.Request(url, headers=HEADERS)
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read().decode())
    
    tag = data.get("tag_name", "").lstrip("v")
    asset = next((a for a in data.get("assets", []) if match_func(a["name"])), None)
    return tag, (asset["browser_download_url"] if asset else None), (asset["name"] if asset else None)

def get_fdroid_latest(pkg_url):
    req = urllib.request.Request(pkg_url, headers=HEADERS)
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read().decode())
    pkg = data.get("package", {})
    suggested = data.get("suggestedVersionCode")
    for p in data.get("packages", []):
        if p.get("versionCode") == suggested:
            v_name = p.get("versionName")
            apk_name = p.get("apkName")
            download_url = f"https://f-droid.org/repo/{apk_name}"
            return v_name, download_url, apk_name
    return None, None, None

def update_app(app):
    name = app["name"]
    pkg = app["package"]
    print(f"🔍 Kontrolujem: {name} ({pkg})")
    
    installed_ver = get_installed_version(pkg)
    if not installed_ver:
        print(f"   ℹ️  Aplikácia nie je v zariadení nainštalovaná. Preskakujem.")
        return

    print(f"   Nainštalovaná verzia: {installed_ver}")

    try:
        if app["type"] == "github":
            latest_ver, apk_url, apk_name = get_github_latest(app["repo"], app["match"])
        elif app["type"] == "fdroid":
            latest_ver, apk_url, apk_name = get_fdroid_latest(app["repo_url"])
        else:
            return

        print(f"   Najnovšia verzia:     {latest_ver}")

        clean_inst = installed_ver.lstrip("v").split("-")[0]
        clean_lat = latest_ver.lstrip("v").split("-")[0]

        if clean_inst == clean_lat or installed_ver in latest_ver:
            print(f"   ✨ Aplikácia je aktuálna.\n")
            return

        if not apk_url:
            print(f"   ⚠️  Nenašiel sa vhodný 32-bit APK asset pre update.\n")
            return

        local_path = f"/tmp/{apk_name}"
        print(f"   ⬇️  Sťahujem {apk_name}...")
        urllib.request.urlretrieve(apk_url, local_path)

        print(f"   📲 Inštalujem update do Streamera...")
        res = run_adb(["install", "-r", "-d", local_path])

        if res.returncode == 0 and "Success" in res.stdout:
            print(f"   🎉 ÚSPECH: Aktualizované na {latest_ver}!\n")
        else:
            print(f"   ❌ Zlyhala inštalácia: {res.stdout.strip()} {res.stderr.strip()}\n")

        if os.path.exists(local_path):
            os.remove(local_path)

    except Exception as e:
        print(f"   ❌ Chyba pri kontrole: {e}\n")

def main():
    ensure_connected()
    for app in APPS:
        update_app(app)
    print("🏁 Hotovo. Všetky spravované appky boli skontrolované.")

if __name__ == "__main__":
    main()
